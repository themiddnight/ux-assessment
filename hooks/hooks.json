{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^ux-assessment:",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/driver/usage.mjs\" hook", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/driver/usage.mjs\" hook", "timeout": 10 }
        ]
      }
    ]
  }
}
